#!/usr/bin/env node
// `gh` CLI stub. No shipped workflow shells out to `gh`, so this should never be
// reached. It exists so that if one ever starts, the test fails loudly here
// rather than quietly reaching the network from a test run.
process.stderr.write(`gh stub: unexpected call: gh ${process.argv.slice(2).join(' ')}\n`);
process.exit(1);
