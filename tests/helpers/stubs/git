#!/usr/bin/env node
// `git` stub. Implements only the calls the workflows make, driven by env:
//   git tag --list                         -> newline-separated __GIT_TAGS
//   git rev-parse -q --verify refs/tags/X  -> exit 0 iff X is in __GIT_TAGS
//   git diff --name-only <range>           -> newline-separated __GIT_DIFF_FILES
// Any other git call fails loud, so a new call site shows up as a test failure
// rather than silently returning nothing.
const args = process.argv.slice(2);
const lines = (value) => (value || '').split('\n').map((s) => s.trim()).filter(Boolean);

if (args[0] === 'tag' && args.includes('--list')) {
  process.stdout.write((process.env.__GIT_TAGS || '') + (process.env.__GIT_TAGS ? '\n' : ''));
  process.exit(0);
}

if (args[0] === 'rev-parse' && args.includes('--verify')) {
  const ref = args[args.length - 1];
  const tag = ref.replace(/^refs\/tags\//, '');
  // Tags are matched exactly. The release workflow strips a `v` prefix when it
  // SCANS for the latest tag, but the ref it verifies is the literal version
  // string it is about to create, so `v1.2.3` must not satisfy `1.2.3`.
  process.exit(lines(process.env.__GIT_TAGS).includes(tag) ? 0 : 1);
}

if (args[0] === 'diff' && args.includes('--name-only')) {
  const files = lines(process.env.__GIT_DIFF_FILES);
  process.stdout.write(files.length ? `${files.join('\n')}\n` : '');
  process.exit(0);
}

process.stderr.write(`git stub: unexpected call: git ${args.join(' ')}\n`);
process.exit(1);
